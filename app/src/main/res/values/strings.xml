    <string name="pref_block_reset_title">Block Brightness Curve Reset</string>
    <string name="pref_block_reset_desc">Blocks both resetAutoBrightness() and resetAutoBrightness(int) triggered by the screen-off alarm (including ColorOS 17 DragOpt).</string>
    <string name="pref_block_ambient_title">Block Ambient Adapter Reset</string>
    <string name="pref_block_ambient_desc">Blocks resetAmbientAdapter() in OplusBrightnessAmbientAdapter on AutoReset and timer alarms.</string>
    <string name="pref_stability_guard_title">Anti-Drift Ambient Lock</string>
    <string name="pref_stability_guard_desc">Blocks micro-drift updates in OplusBrightnessAmbientAdapter (handleStableForceChange / handleSmallChangeAnimating) under steady lighting.</string>
    <string name="pref_min_floor_title">Night Floor (8.5 nits) &amp; Dark-Env Guard</string>
    <string name="pref_min_floor_desc">Skips 20-min progressive dark-room dimming (OplusFeatureDarkEnvReduceBrightness) and enforces &gt;= 8.5 nits in convertNitToBrightness().</string>
    <string name="pref_debounce_lock_title">Debounce Window Stabilizer</string>
    <string name="pref_debounce_lock_desc">Caps StabilityProcess.getAccelerateScale() at 1.0x so LuxQueueProcess keeps full SceneConfig timers against hand tremor jitter.</string>
    <string name="pref_smart_dimming_title">Per-App Smart Dimming Bypass</string>
    <string name="pref_smart_dimming_desc">Disables AppFossReduceConfig app-specific dimming in OplusFeatureReduceBrightness (browsers, messengers, readers).</string>
    <string name="pref_dual_sensor_title">Dual 360° Aux Sensor Balancer</string>
    <string name="pref_dual_sensor_desc">Smooths sudden indoor rear-sensor reflections in LuxEventResult.calculateAuxLux() instead of snapping straight to auxLux.</string>
    <string name="pref_strict_alarm_title">Strict Alarm Rule Only</string>
    <string name="pref_strict_alarm_desc">Bypasses lambda name matching and solely checks AlarmManager stack frames.</string>
    <string name="pref_verbose_log_title">Verbose Debug Logging</string>
    <string name="pref_verbose_log_desc">Log periodic post-processing &amp; stability guard hits in LSPosed / logcat.</string>
